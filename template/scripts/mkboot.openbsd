#!/usr/bin/env bash

# make openbsd boot cd ISO

set -ue

echo "Generating OpenBSD netboot ISO"

TEMPLATE_ROOT=$1
OSREV=$2
MACHINE=$3
MKBOOT_USER=$4
SERIAL=$5
TARGET=$6

# calculated extra buffer blocks for image root filesystem
magic_buffer_blocks=700

# argument examples:
#
# REPO_ROOT=/home/mkrueger/go/src/github.com/rstms/netboot
# OSREV=7.5
# MACHINE=amd64
# MKBOOT_USER=mkrueger
# TARGET=iso

echo TEMPLATE_ROOT=$TEMPLATE_ROOT
echo OSREV=$OSREV
echo MACHINE=$MACHINE
echo MKBOOT_USER=$MKBOOT_USER
echo SERIAL=$SERIAL
echo TARGET=$TARGET

fail() {
  echo >&2 $0: "$@"
  exit 1
}

OS=$(uname)
case $OS in 
    OpenBSD) ;;
    *) fail "OpenBSD is required for this operation";;
esac 

[ -n "$TEMPLATE_ROOT" ] || fail "no TEMPLATE_ROOT"
[ -n "$OSREV" ] || fail "no OSREV (version)"
[ -n "$MACHINE" ] || "fail no MACHINE (arch)"
[ -n "$MKBOOT_USER" ] || "fail no MKBOOT_USER"

TAG=$(tr <<<$OSREV -d '.')
SRC_ISO=$TEMPLATE_ROOT/dist/openbsd/$OSREV/$MACHINE/cd${TAG}.iso
DST_ISO=$TEMPLATE_ROOT/ipxe/openbsd-$OSREV-$MACHINE.iso
SRC_IMG=$TEMPLATE_ROOT/dist/openbsd/$OSREV/$MACHINE/miniroot${TAG}.img
DST_IMG=$TEMPLATE_ROOT/ipxe/openbsd-$OSREV-$MACHINE.img
DST_RD=$TEMPLATE_ROOT/ipxe/bsd-$OSREV-$MACHINE.rd
RC_NETBOOT=$TEMPLATE_ROOT/mkboot/rc.netboot.openbsd

DIR=$(mktemp -td netboot-mkboot-openbsd-XXXXXXXXX)
RD=$DIR/rd
CD=$DIR/cd
ISO=$DIR/iso
IMG=$DIR/img


#echo DST_ISO=$DST_ISO
#echo SRC_ISO=$SRC_ISO
#echo OSREV=$OSREV
#echo MACHINE=$MACHINE
#echo MKBOOT_USER=$MKBOOT_USER

vnd0_clear() {
    vnconfig -l | grep -q 'vnd0: not in use'
}

vnd1_clear() {
    vnconfig -l | grep -q 'vnd1: not in use'
}

vnd2_clear() {
    vnconfig -l | grep -q 'vnd2: not in use'
}


cleanup() {
    mounted=$(mount | awk '/^\/dev\/vnd0/{ print $1 }')
    if [ -n "$mounted" ]; then
	umount $mounted
    fi
    vnd0_clear || vnconfig -u vnd0
    mounted=$(mount | awk '/^\/dev\/vnd1/{ print $1 }')
    if [ -n "$mounted" ]; then
	umount $mounted
    fi
    vnd1_clear || vnconfig -u vnd1
    mounted=$(mount | awk '/^\/dev\/vnd2/{ print $1 }')
    if [ -n "$mounted" ]; then
	umount $mounted
    fi
    vnd2_clear || vnconfig -u vnd2

    if [ -n "$DIR" ]; then
	if [ -d $DIR ]; then
	    rm -rf $DIR
	fi
    fi
}

#cleanup

vnd0_clear || fail 'vnd0 in use' 
vnd1_clear || fail 'vnd1 in use' 
vnd2_clear || fail 'vnd2 in use' 

trap cleanup EXIT

modify_ramdisk_on_vnd1() {

  # mount ramdisk using vnd1
  vnconfig vnd1 $DIR/ramdisk.img
  rm -rf $RD
  mkdir $RD
  mount /dev/vnd1a $RD

  # add netboot autoinstall shim to ramdisk
  install -o root -g wheel -m 0755 $RC_NETBOOT $RD/rc.netboot
  
  sed -i -e "s/__NETBOOT_GEN_TIMESTAMP__/$(date)/" $RD/rc.netboot
  sed -i -e "s/__NETBOOT_GEN_HOST__/$(uname -a)/" $RD/rc.netboot

  # add rc.netboot pre_install call to ramdisk /.profile
  if [ "$OSREV" \< "7.8" ]; then
    awk <$RD/.profile '{print $0} /autoinstall -x/{print "\t/rc.netboot pre_install"}' >$RD/_profile
  else
    awk <$RD/.profile '{print $0} /upgrade -ax/{print "\t/rc.netboot pre_install"}' >$RD/_profile
  fi

  mv $RD/_profile $RD/.profile
  chmod 0755 $RD/.profile
  
  # add rc.netboot post_install call to ramdisk /install.sub
  awk <$RD/install.sub '/exec reboot$/{ print "\t/rc.netboot post_install" } {print $0}' >$RD/_install.sub
  mv $RD/_install.sub $RD/install.sub
  chmod 0755 $RD/install.sub

  # unmount ramdisk
  umount $RD
  vnconfig -u vnd1
  rmdir $RD

}

build_iso() {

  echo "generating $DST_ISO"

  # create directory for cd filesystem
  mkdir -p $CD/${OSREV}/${MACHINE}
  mkdir $CD/etc
  
  # mount source ISO on vnd0 and extract files
  mkdir $ISO
  vnconfig vnd0 $SRC_ISO
  mount /dev/vnd0a $ISO
  cp ${ISO}/${OSREV}/${MACHINE}/bsd* ${CD}/${OSREV}/${MACHINE}/
  cp ${ISO}/${OSREV}/${MACHINE}/cdb* ${CD}/${OSREV}/${MACHINE}/
  
  # free up vnd0
  umount $ISO
  vnconfig -u vnd0
  rmdir $ISO
  
  # extract ramdisk from kernel
  rdsetroot -x ${CD}/${OSREV}/${MACHINE}/bsd.rd $DIR/ramdisk.img
  
  modify_ramdisk_on_vnd1 $DIR/ramdisk.img
  
  # insert modified ramdisk into cd image kernel
  rdsetroot ${CD}/${OSREV}/${MACHINE}/bsd.rd $DIR/ramdisk.img

  # copy bsd ramdisk to IPXE output dir
  cp ${CD}/${OSREV}/${MACHINE}/bsd.rd $DST_RD
  
  # point bootloader at ramdisk kernel
  echo "set image /${OSREV}/${MACHINE}/bsd.rd" >$CD/etc/boot.conf

  # optionally enable serial
  if [ "$SERIAL" != "no" ]; then
    echo "set tty $SERIAL" >>$CD/etc/boot.conf
  fi
  
  # build the iso
  mkhybrid -a -R -T -L -l -d -D -N -o $DST_ISO \
          -A "OpenBSD ${OSREV} ${MACHINE} netboot CD" \
  	    -P "Copyright (c) `date +%Y` Theo de Raadt, The OpenBSD project" \
  	    -p "Theo de Raadt <deraadt@openbsd.org>, install modifications by Matt Krueger <mkrueger@rstms.net>" \
  	    -V "OpenBSD/${MACHINE}   ${OSREV} netboot CD" \
  	    -b ${OSREV}/${MACHINE}/cdbr \
              -c ${OSREV}/${MACHINE}/boot.catalog \
  	    $CD
}

build_img() {

  #
  # NOTE: this uses $DST_RD -- created by this script when called with TARGET=iso
  # The makefile sets the iso file as a prerequisite of the img file
  #
 
  echo "generating $DST_IMG"

  # preserve modification time of SRC_IMG
  SRC_IMG_MTIME=$(stat -f '%Dm' $SRC_IMG)

  # mount src image on vnd0
  vnconfig vnd0 $SRC_IMG

  #fdisk -v vnd0
  #disklabel -v vnd0

  # read maxblocks from source root filesystem
  maxblocks=$(tunefs -N /dev/vnd0a | awk '/maximum blocks per file/{ print $(NF) }')

  # mount src root filesystem
  mkdir $IMG.src
  mount /dev/vnd0a $IMG.src

  # read EFI partition block count from SRC_IMG
  efi_blocks=$(disklabel vnd0 | awk '/^[[:space:]]*i:[[:space:]]/{print $2}')

  # calculate src image kernel size in 512-byte blocks
  src_kernel_blocks=$(stat -s $IMG.src/bsd | awk '{ gsub(/st_size=/, "", $8); printf("%d\n", ($8 / 512) + 1); }')

  # calculate customized ramdisk kernel size in blocks
  ramdisk_kernel_blocks=$(stat -s $DST_RD | awk '{ gsub(/st_size=/, "", $8); printf("%d\n", ($8 / 512) + 1); }')

  # calculate src image size in blocks
  src_image_blocks=$(stat -s $SRC_IMG | awk '{ gsub(/st_size=/, "", $8); printf("%d\n", ($8 / 512) + 1); }')

  kernel_offset_blocks=$(( $ramdisk_kernel_blocks - $src_kernel_blocks ))

  dst_image_blocks=$(( $src_image_blocks + $kernel_offset_blocks + $magic_buffer_blocks))

  dd if=/dev/zero of=$DST_IMG bs=512 count=$dst_image_blocks
  
  ls -l $DST_IMG

  # mount dst image on vnd1 
  vnconfig vnd1 $DST_IMG

  # init partition table on DST
  fdisk -yib$efi_blocks vnd1

  # copy EFI partition from SRC_IMG to DST_IMG
  dd if=/dev/vnd0i of=/dev/vnd0i

  echo '/ * 100' | disklabel -wAT- vnd1 

  #fdisk -v vnd1
  #disklabel -v vnd1

  # create and mount dst root filesystem
  newfs -m0 -o space -e $maxblocks /dev/rvnd1a
  mkdir $IMG.dst
  mount /dev/vnd1a $IMG.dst

  # copy files from src root dst root
  cp -rp $IMG.src/* $IMG.dst

  ls -al $DST_RD
  ls -al $IMG.dst/bsd
  rm $IMG.dst/bsd

  # replace dst/bsd with modified ramdisk image
  cp $DST_RD $IMG.dst/bsd

  mkdir -p $IMG.dst/etc
  echo "set image /bsd" >$IMG.dst/etc/boot.conf

  # optionally enable serial
  if [ "$SERIAL" != "no" ]; then
    echo "set tty $SERIAL" >>$IMG.dst/etc/boot.conf
  fi

  umount $IMG.src
  umount $IMG.dst
  
  # unmount and disconnect src vnd0
  rmdir $IMG.src
  vnconfig -u vnd0

  # unmount and disconnect dst vnd1
  rmdir $IMG.dst
  vnconfig -u vnd1

  # restore modification time of SRC_IMG
  touch -t $(date -r $SRC_IMG_MTIME '+%Y%m%d%H%M.%S') $SRC_IMG
}

case $TARGET in 
    iso)
	build_iso
	chown -R $MKBOOT_USER.$MKBOOT_USER $DIR
	chown $MKBOOT_USER.$MKBOOT_USER $DST_ISO
	chmod 0660 $DST_ISO
	rm -f $DST_ISO.gz
	gzip $DST_ISO
	ls -l $DST_ISO.gz
	;;
    img)
	build_img
	chown -R $MKBOOT_USER.$MKBOOT_USER $DIR
	chown $MKBOOT_USER.$MKBOOT_USER $DST_IMG
	chmod 0660 $DST_IMG
	rm -f $DST_IMG.gz
	gzip $DST_IMG
	ls -l $DST_IMG.gz
	;;
esac


