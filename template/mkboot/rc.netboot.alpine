#!/bin/sh

# alpine rc.netboot
# included in MAC.apkovl.tgz as /etc/local.d/auto-setup-alpine.start

echo >>/dev/console "Executing /rc.netboot ($0)"

mkdir /cdrom
echo "Attempting /dev/cdrom ISO9660 mount..."
if mount -t iso9660 -o ro /dev/cdrom /cdrom ; then
    mount | grep /cdrom
else
    echo "CDROM mount failed, trying /dev/sda as FAT filesystem..."
    apk add mtools
    if minfo -i /dev/sda | grep SYSLINUX; then
	mcopy -i /dev/sda ::keymaster.pem /cdrom
	mcopy -i /dev/sda ::netboot.pem /cdrom
	mcopy -i /dev/sda ::netboot.key /cdrom
	mcopy -i /dev/sda ::netboot_exec /cdrom
	mcopy -i /dev/sda ::netboot.env /cdrom
    fi
fi

ls -l /cdrom
cat /cdrom/netboot.env

. /cdrom/netboot.env


if [ -z "$_quiet" ]; then
    exec 1>>/dev/console 2>&1
fi 

if [ -n "$_debug" ]; then
    set -x
fi

# install curl
apk add curl

# download /ipxe/MAC.postinstall as /postinstall 
curl ${_certs} ${_url}/ipxe/${_mac}.postinstall -o /postinstall
chmod 0700 /postinstall

# run only once
rm -f /etc/local.d/auto-setup-alpine.start

/postinstall
postinstall_exit=$?

if [ $postinstall_exit != 0 ]; then
    echo "rc.netboot: /postinstall failed with exit code $postinstall_exit"
    echo "rebooting in 30 seconds..."
    sleep 30
fi

/sbin/reboot
