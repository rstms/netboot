#!/bin/sh

# alpine rc.netboot
# included in MAC.apkovl.tgz as /etc/local.d/auto-setup-alpine.start

set -ue 

exec >/dev/console 2>&1

echo "Executing $0"

_debug=1

console_prompt() {
    echo "$@"
    if [ -n "$_debug" ]; then
	echo "[enter to continue]"
	read </dev/console response
    fi
}

console_prompt "rc.netboot.alpine"

on_exit() {
    console_prompt "Exiting $0"
    if [ -n "$_shutdown" ]; then
	/sbin/poweroff
    else
	/sbin/reboot
    fi
}
trap on_exit EXIT 

mkdir /cdrom
echo "Attempting /dev/cdrom ISO9660 mount..."
if mount -t iso9660 -o ro /dev/cdrom /cdrom ; then
    mount | grep /cdrom
else
    echo "CDROM mount failed, trying /dev/sda as FAT filesystem..."
    apk add mtools
    if minfo -i /dev/${_root} | grep SYSLINUX; then
	mcopy -i /dev/${_root} ::keymaster.pem /cdrom
	mcopy -i /dev/${_root} ::netboot.pem /cdrom
	mcopy -i /dev/${_root} ::netboot.key /cdrom
	mcopy -i /dev/${_root} ::netboot_exec /cdrom
	mcopy -i /dev/${_root} ::netboot.env /cdrom
    fi
fi

. /cdrom/netboot.env

mac_addr=$(ifconfig $_egress | awk '/[[:space:]]HWaddr[[:space:]]/{print $5}' | tr -d ':' | tr 'A-Z' 'a-z')
echo "mac_address=$mac_addr"

ip_addr=$(ifconfig $_egress | awk '/[[:space:]]inet addr:/{gsub(/^.*:/, "", $2); print $2}')
echo "ip_address=$ip_addr"

echo "bootstrap_id=$_bootstrap_id"

# install curl
apk add curl

if [ "$_mac" == "000000000000" ]; then
    report_url="${_url}/api/bootstrap/${_bootstrap_id}/${mac_addr}/${ip_addr}/"
    console_prompt "Sending $report_url"
    sleep 15
    curl -v -L -X PUT -o /dev/console ${_certs} "$report_url"
    sleep 60
    console_prompt "shutdown in 5 seconds..."
    sleep 5
    /sbin/poweroff
    exit
fi

if [ -n "$_image_load" ]; then
    console_prompt "loading netboot.img"
    curl -Ls -o netboot.img ${_certs} ${_url}/ipxe/${mac_addr}.img
    # write image to hdd
    #console_prompt "writing netboot.img to /dev/${_image_load}"
    #dd if=netboot.img of=/dev/${_image_load}
    sh </dev/console  2>&1
    report_url="${_url}/api/status/imaged/${mac_addr}/${ip_addr}/"
    console_prompt "Sending $report_url"
    curl -L -X PUT -o /dev/console ${_certs} "$report_url"
    console_prompt "shutdown in 5 seconds..."
    sleep 5
    /sbin/poweroff
    exit
fi

# send 'init' host status 
report_url="${_url}/api/status/init/${mac_addr}/${ip_addr}/"
console_prompt "Sending $report_url"
curl -L -X PUT -o /dev/console ${_certs} "$report_url"

# download /ipxe/MAC.postinstall as /postinstall 
curl ${_certs} ${_url}/ipxe/${mac_addr}.postinstall -o /postinstall

# run only once
rm -f /etc/local.d/auto-setup-alpine.start

sh </dev/console  2>&1 /postinstall
postinstall_exit=$?

if [ $postinstall_exit != 0 ]; then
    echo "rc.netboot: /postinstall failed with exit code $postinstall_exit"
    echo "rebooting in 5 seconds..."
    sleep 5
fi


