#!/bin/sh

# debian rc.netboot
# staged for download as MAC.postinstall
# loaded by debian autoexec.ipxe to install ramdisk /rc.netboot
#
# called 3 times during installer: 
#   d-i preseed/early_command
#   d-i partman/early_command
#   d-i preseed/late_command

# preseed.cfg passes netboot URL (configured by boxen) as argument

preseed_early_command() {

    tar zxf /netboot.tgz
    echo "preseed_early_command" >>/netboot/preseed_early.log

    tar zxf /cacerts.tgz

#    mkdir /netboot.device
#    mount -t iso9660 -o ro /dev/cdrom /netboot.device || mount -t vfat -o ro /dev/sda /netboot.device
#
#    mount >>/netboot/preseed_early.log
#
#    cp /netboot.device/*.env /netboot
#    cp /netboot.device/*.pem /netboot
#    cp /netboot.device/*.key /netboot
#    cp /netboot.device/netboot_exec /netboot
#
#    umount /netboot.device
#    rmdir /netboot.device
#
#    ls -al /netboot.device >>/netboot/preseed_early.log
#    cat /netboot/netboot.env >>/netboot/preseed_early.log
}
    
partman_early_command() {
    echo "partman_early_command: setting hostname $1" >>/netboot/partman_early.log
    hostname $1
}

preseed_late_command() {

    echo "preseed_late_command" >>/netboot/preseed_late.log

    . /netboot/netboot.env

    # create netboot output dir
    mkdir -p /target/root/.netboot
    chmod 0700 /target/root/.netboot
    
    # preserve config files in netboot output dir
    cp /preseed.cfg /target/root/.netboot
    cp -rp /netboot /target/root/.netboot/tmp_netboot
    
    _mac=$(ip address | awk '/link\/ether/{print $2}' | tr -d ':')
    _log=/target/root/.netboot/package
    _wget="wget --ca-certificate /netboot/keymaster.pem --certificate=/netboot/netboot.pem --private-key=/netboot/netboot.key"
    _tarball=${_url}/ipxe/${_mac}.tgz
    
    $_wget $_tarball -O - | tar zxv -C /target >${_log}.stdout 2>${_log}.stderr
    echo $? >${_log}.exitcode
    
    # fix tarball directory permissions 
    chmod 0755 /target
    chmod 0755 /target/etc
    chmod 0755 /target/etc/ssl
    
    rm -rf /netboot
}

case $1 in 
    preseed_early) shift; preseed_early_command "$@" ;;
    partman_early) shift; partman_early_command "$@" ;;
    preseed_late) shift; preseed_late_command "$@" ;;
done
