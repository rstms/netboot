#!ipxe

# Debian MAC autoconfig netboot

set debian_mirror https://localboot.rstms.net
set netboot https://localboot.rstms.net
set debian_version bookworm
set kernel_params

set bootfile ${netboot}/ipxe/${net0/mac}

set netcfg interface=eth0 net.ifnames=0
set install_params auto=true priority=critical biosdevname=0
set preseed preseed/url=${bootfile}.conf
set mirrorcfg mirror/suite=${debian_version}

imgfree
kernel ${bootfile}.kernel ${netcfg} ${install_params} ${mirrorcfg} ${preseed} ${kernel_params}
initrd ${bootfile}.initrd
boot

exit 0
