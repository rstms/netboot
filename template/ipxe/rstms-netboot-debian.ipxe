#!ipxe

# Debian MAC autoconfig netboot

set netboot https://localboot.rstms.net
set kernel_params
set serial_params

iseq ${cls} serial && goto ignore_cls ||
set cls:hex 1b:5b:4a  # ANSI clear screen sequence - "^[[J"
set cls ${cls:string}

:ignore_cls

#console --x 1024 --y 768
#console --picture https://${netboot}/ipxe.png

dhcp && goto dhcp_ok ||
echo "failed DHCP network configuration"
sleep 5
reboot

:dhcp_ok

ntp pool.ntp.org && goto ntp_ok ||
echo "failed NTP clock reset"
sleep 5
reboot

:ntp_ok

set bootfile ${netboot}/ipxe/${net0/mac}
set netcfg interface=eth0 net.ifnames=0
set install_params auto=true priority=critical biosdevname=0
#set preseed preseed/url=${bootfile}.response

imgfree
kernel ${bootfile}.kernel ${netcfg} ${install_params} ${serial_params} ${kernel_params}
initrd ${bootfile}.initrd
initrd ${bootfile}.response /preseed.cfg
initrd ${bootfile}.cacerts /cacerts.tgz
initrd ${bootfile}.postinstall /postinstall mode=0700
boot

exit 0
