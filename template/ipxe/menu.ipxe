#!ipxe

:start
isset ${arch} && goto skip_arch_detect ||
cpuid --ext 29 && set arch x86_64 || set arch i386
iseq ${buildarch} arm64 && set arch arm64 ||
:skip_arch_detect
ntp pool.ntp.org ||
iseq ${cls} serial && goto ignore_cls ||
set cls:hex 1b:5b:4a  # ANSI clear screen sequence - "^[[J"
set cls ${cls:string}
:ignore_cls

#console --x 1024 --y 768
#console --picture http://boot.ipxe.org/ipxe.png
echo templates/menu/menu.ipxe.j2

dhcp || echo "dhcp failed"

:main_menu
clear main_menu_choice
echo ${cls}
menu Reliance Systems Netboot Menu
item --gap Default:
item mac_autoinstall MAC Address Autoinstall
item local Boot from local hdd
item --gap Tools:
item shell iPXE shell
choose --timeout 5000 --default mac_autoinstall main_menu_choice || goto local
echo ${cls}
goto ${main_menu_choice}
goto main_menu


:error
echo Error occured, press any key to return to menu ...
prompt
goto main_menu

:mac_autoinstall
echo ${cls}
chain --replace https://localboot.rstms.net/ipxe/${net0/mac}.ipxe || error

:local
echo Booting from local disks ...
exit 1

:shell
echo Type "exit" to return to menu.
shell
goto main_menu

:menu_exit
exit
